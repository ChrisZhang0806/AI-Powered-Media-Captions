# OpenAI API Key for Whisper transcription
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional backend defaults. Users can also provide their API key in the UI.
OPENAI_API_KEY=
PORT=3001
UPLOAD_DIR=
OUTPUT_DIR=
UPLOAD_CHUNK_SIZE_MB=8
MEDIA_PROCESSING_CONCURRENCY=2
STREAMING_TRANSCRIPTION_CONCURRENCY=2
STREAMING_SEGMENT_SECONDS=35
STREAMING_SEGMENT_MAX_SECONDS=50
STREAMING_SILENCE_THRESHOLD=160
